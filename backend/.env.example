APP_NAME=AnomalyGuard Water API
APP_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://anomaly:anomaly@db:5432/anomalyguard
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ENABLE_SIMULATOR=true
POLL_INTERVAL_SECONDS=1.0
REDIS_URL=redis://redis:6379/0
MEMORY_CACHE_TTL_SECONDS=300
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=anomalyguard
MONGODB_MEMORY_COLLECTION=rag_memory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ALERTS=anomaly-alerts
ENABLE_KAFKA_PUBLISH=false
MLFLOW_TRACKING_URI=file:./mlruns

