APP_NAME=AnomalyGuard Water API
APP_VERSION=1.0.0
DATABASE_URL=postgresql+psycopg://anomaly:anomaly@db:5432/anomalyguard
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ENABLE_SIMULATOR=true
POLL_INTERVAL_SECONDS=1.0
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ALERTS=anomaly-alerts
ENABLE_KAFKA_PUBLISH=false
ENABLE_NOTIFICATIONS=true
ENABLE_ASYNC_NOTIFICATIONS=false
ENABLE_WEBHOOK_NOTIFICATIONS=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=5.0
SMTP_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_API_BASE=https://api.twilio.com/2010-04-01
MLFLOW_TRACKING_URI=file:./mlruns
