APP_NAME=AnomalyGuard Water API
APP_VERSION=1.0.0
APP_ENV=development
ALLOW_INSECURE_DEFAULTS=false
DATABASE_URL=postgresql+psycopg://anomaly:anomaly@db:5432/anomalyguard
JWT_SECRET_KEY=
JWT_SECRET_KEY_FILE=.secrets/jwt_secret_key.txt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=ops-admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_FILE=.secrets/admin_password.txt
DEVICE_API_KEY=
DEVICE_API_KEY_FILE=
DEVICE_KEYS_PATH=.secrets/device_keys.json
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGIN_REGEX=
ENABLE_SIMULATOR=true
POLL_INTERVAL_SECONDS=1.0
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ALERTS=anomaly-alerts
ENABLE_KAFKA_PUBLISH=false
MLFLOW_TRACKING_URI=file:./mlruns
COMMUNITY_IMPACT_PROFILE_PATH=
